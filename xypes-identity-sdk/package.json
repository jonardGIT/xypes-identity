{
  "name": "@xypes-identity/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:shared": "npm --prefix ../shared run build",
    "build": "npm run build:shared && tsc -p tsconfig.json",
    "onboarding:seed": "tsx scripts/render-onboarding-seed.ts",
    "typecheck": "npm run build:shared && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@xypes-identity/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/node": "^22.15.31",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}